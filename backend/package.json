{
  "name": "dream-craft-backend",
  "version": "1.0.0",
  "description": "Realtime server for Dream Craft: rooms, the shared block world and the mini-games.",
  "license": "ISC",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "socket.io-client": "^4.8.1"
  },
  "nodemonConfig": {
    "watch": [
      ".",
      "../shared"
    ],
    "ignore": [
      "data/**",
      "tests/**"
    ],
    "ext": "js,json"
  }
}
